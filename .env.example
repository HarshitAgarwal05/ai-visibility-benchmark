# Engine keys — only the engines you list in config.engines are required.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Judge. Defaults to the OpenAI key if unset.
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini

# Optional: only when storage.driver is "bigquery"
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# BIGQUERY_PROJECT_ID=
